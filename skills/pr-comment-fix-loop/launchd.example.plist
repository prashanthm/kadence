<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-sdlc.pr-comment-fix-loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_PRODUCT_WORKSPACE/scripts/pr-comment-fix-loop-cron.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>REPLACE_WITH_HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>REPLACE_WITH_HOME</string>
    <key>PR_FIX_CONFIG</key>
    <string>REPLACE_WITH_HOME/.config/ai-sdlc/pr-comment-fix-loop.yaml</string>
    <key>PR_FIX_TOOLKIT</key>
    <string>REPLACE_WITH_PRODUCT_WORKSPACE/kadence</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Minute</key>
      <integer>15</integer>
    </dict>
    <dict>
      <key>Minute</key>
      <integer>45</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_HOME/.local/share/ai-sdlc/pr-comment-fix-loop-cron.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_HOME/.local/share/ai-sdlc/pr-comment-fix-loop-cron.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
