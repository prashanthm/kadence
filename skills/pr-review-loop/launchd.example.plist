<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Informational example. The real plist is generated by pr-review-loop-setup.sh install. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-sdlc.pr-review-loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_PRODUCT_WORKSPACE/scripts/pr-review-loop-cron.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>15</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_HOME/.local/share/ai-sdlc/pr-review-loop-cron.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_HOME/.local/share/ai-sdlc/pr-review-loop-cron.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
